{
  "name": "agrega",
  "private": true,
  "version": "0.1.0",
  "description": "Agrega - ERP para construtoras",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mcp"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test -w apps/api",
    "dev:mcp": "npm run dev -w apps/mcp",
    "start:mcp": "npm run start -w apps/mcp",
    "docs": "npm run docs -w apps/api"
  }
}
