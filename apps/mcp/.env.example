# Copie para .env no desenvolvimento local. No Railway, cadastre como variáveis do serviço do MCP.

# Endereço da API do Agrega (apps/api). No Railway, use o endereço interno ou o público do serviço da API.
API_BASE_URL=http://localhost:3000

# Tela de login/autorização do Agrega (apps/web, rota /oauth/authorize). Em produção: https://SEU-DOMINIO/oauth/authorize
AGREGA_AUTHORIZE_URL=http://localhost:5173/oauth/authorize

# URL pública deste servidor (issuer do OAuth, metadados, WWW-Authenticate). Em produção é obrigatória na prática:
# com ela o servidor também confere o cabeçalho Host no /mcp. Ex.: https://mcp.SEU-DOMINIO
# O mesmo endereço + /oauth/callback precisa estar em MCP_CALLBACK_URLS no serviço da API.
PUBLIC_BASE_URL=

# Segredo que ASSINA os client_id e CIFRA os tokens de acesso e de renovação. Precisa ser o MESMO entre deploys:
# é ele que faz a conexão do usuário sobreviver a um reinício. Obrigatório em produção (mínimo de 32 caracteres).
# Gere com: openssl rand -hex 32
OAUTH_SIGNING_SECRET=

# Validade (s) do token de acesso entregue ao Claude/ChatGPT. Curta de propósito: a renovação é automática.
MCP_ACCESS_TOKEN_TTL=3600

# Domínios aceitos nos endereços de retorno dos clientes (registro dinâmico e authorize), separados por vírgula.
ALLOWED_REDIRECT_DOMAINS=claude.ai,claude.com,anthropic.com,chatgpt.com,platform.openai.com

# Origens CORS permitidas, separadas por vírgula. Vazio = todas (só para desenvolvimento).
CORS_ALLOWED_ORIGINS=

# Hosts extras aceitos no /mcp (localhost e o host de PUBLIC_BASE_URL já entram).
ALLOWED_HOSTS=

# true quando houver proxy na frente (Railway, nginx).
TRUST_PROXY=true

# Só para o ChatGPT, que não faz registro dinâmico: cliente fixo. Sem o segredo, o cliente fixo não é criado.
OAUTH_CLIENT_ID=agrega-chatgpt-mcp
OAUTH_CLIENT_SECRET=

# Porta local (o Railway define PORT sozinho).
MCP_HTTP_PORT=3001
NODE_ENV=development
