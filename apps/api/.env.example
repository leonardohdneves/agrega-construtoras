# Copie para .env no desenvolvimento local. No Railway, cadastre como variáveis do serviço.
DATABASE_URL=postgres://usuario:senha@localhost:5432/agrega
# Segredo longo e aleatório para assinar as sessões (obrigatório em produção)
JWT_SECRET=
PORT=3000
# Primeiro acesso do administrador do sistema (criado só se ainda não existir)
ADMIN_EMAIL=
ADMIN_SENHA=
# Ambiente de teste: cria a Concreteira Exemplo com dono, gestor e motorista
SEED_DEMO=false
DEMO_SENHA=
