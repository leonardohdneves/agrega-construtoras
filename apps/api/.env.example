# Copie para .env no desenvolvimento local. No Railway, cadastre como variáveis do serviço.
DATABASE_URL=postgres://usuario:senha@localhost:5432/agrega
# Segredo longo e aleatório para assinar as sessões (obrigatório em produção)
JWT_SECRET=
PORT=3000
# Primeiro acesso do administrador do sistema (criado só se ainda não existir)
ADMIN_EMAIL=
ADMIN_SENHA=
# Ambiente de teste: cria a Concreteira Exemplo com dono, gestor e motorista
SEED_DEMO=false
DEMO_SENHA=
# Servidor MCP (assistentes de IA): endereços /oauth/callback autorizados a receber o código de login, separados por vírgula.
# Ex.: https://mcp.seudominio.com.br/oauth/callback
MCP_CALLBACK_URLS=
# Segredo compartilhado com o servidor MCP (o mesmo valor de MCP_API_SECRET no serviço do MCP), com 32 caracteres ou mais.
# Sem ele, em produção, a troca do código de login e a renovação do OAuth recusam tudo. Gere com: openssl rand -hex 32
MCP_API_SECRET=
